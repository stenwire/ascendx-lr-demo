# Postgres connection used by Prisma
DATABASE_URL="postgresql://leave_app:leave_app@localhost:5432/leave_app?schema=public"

# Port the Express API listens on
PORT=4000

# AI_MODE: "mock" (default when GEMINI_API_KEY is unset) or "live"
# mock  -> deterministic canned approval messages, zero external calls, no key needed
# live  -> real Gemini call via Google ADK (adk-js)
AI_MODE=mock

# Only needed for AI_MODE=live
GEMINI_API_KEY=

# Gemini model name used by the ADK agent
GEMINI_MODEL=gemini-flash-latest

# Minimum fraction (0-1) of a team that must remain available (not on approved leave)
# before the staffing-shortage warning is triggered on approval
STAFFING_MIN_AVAILABLE_RATIO=0.5
